import tkinter as tk


class HanoiSolver:
    def solve(self, n, source, target, auxiliary, callback):
        if n == 0:
            return
        self.solve(n - 1, source, auxiliary, target, callback)
        callback(source, target)
        self.solve(n - 1, auxiliary, target, source, callback)


